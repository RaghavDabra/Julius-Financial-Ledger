+"""Vercel entrypoint: exposes the Flask `app` from api/app.py as a serverless function."""
+
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from app import app  # noqa: E402,F401
